# Copier en .env et remplir avant le premier démarrage. Ne jamais commiter .env.

# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=3000

# true uniquement si le serveur est servi en HTTPS (pas le cas en réseau local simple)
COOKIE_SECURE=false

# Chemin du fichier SQLite. Par défaut : atelier-jo.db à la racine du projet.
# CHEMIN_DB=./atelier-jo.db
